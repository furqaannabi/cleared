# Copy to .env (gitignored). Bun loads .env on its own.
# Local values only: they match docker-compose.yml. Real secrets never go here.

# The local Postgres container started by `pnpm db:up`.
DATABASE_URL="postgresql://cleared:cleared@127.0.0.1:5432/cleared"

# Port the API listens on. The frontend's dev server uses 3000.
PORT=4000

# The address of Cleared's own app. Only requests from it may change anything, and it is where
# the browser is sent after signing in. In production it is the app's subdomain, with https.
APP_ORIGIN="http://localhost:3000"
# The API's own address. Google sends the browser back to it after a sign-in.
API_ORIGIN="http://localhost:4000"

# Google and YouTube. One Google OAuth client does both: signing a creator in, and connecting their
# YouTube channel (read-only). There is no separate YouTube key.
# From console.cloud.google.com, in one project:
#   1. APIs & Services > Library: enable "YouTube Data API v3".
#   2. APIs & Services > OAuth consent screen: External. While it is in Testing, only the Google
#      accounts listed as test users can sign in.
#   3. APIs & Services > Credentials > Create credentials > OAuth client ID (type: Web application).
#      Authorised redirect URIs, for local work:
#        http://localhost:4000/auth/google/callback
#        http://localhost:4000/connect/youtube/callback
# Leave empty to run without Google: only "Try the demo account" can sign in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The one real YouTube channel the team owns, which every demo account reads through, so that a demo
# deal can get its go-ahead, its live check and its payout. Connect it once: sign in to the app with the
# Google account that owns it, connect YouTube, then put the channel's id here (it starts with "UC").
# The Google app must be out of Testing first, or the connection stops working after 7 days.
# Leave empty and a demo account's deal stops once its draft is approved.
DEMO_YOUTUBE_CHANNEL_ID=

# Required: the API does not start without it. The brand's links are worked out from it, and the Google
# tokens kept for connected YouTube channels are encrypted with it. Changing it turns off every link
# and disconnects every channel. Make one with: openssl rand -base64 32
TOKEN_KEY=

# Instagram is not connected yet: nothing reads these, and the names may change when it is built.
# They will come from developers.facebook.com > the app > Instagram > API setup with Instagram login.
# INSTAGRAM_APP_ID=
# INSTAGRAM_APP_SECRET=

# AWS. The model that reads briefs, on Amazon Bedrock, and the region it is called in. The model has
# to be usable by the account first: its offer accepted in the Bedrock console, and a quota above zero
# (Service Quotas > Amazon Bedrock).
BRIEF_MODEL="anthropic.claude-opus-5-5"
AWS_REGION="us-east-1"

# Drafts (the draft check). Leave DRAFTS_BUCKET empty to run without them: no draft can then be sent.
# The service also needs ffmpeg and ffprobe installed (on a Mac: brew install ffmpeg).
#
# A private S3 bucket in AWS_REGION, with public access blocked and encryption on. Add a lifecycle rule
# that deletes anything older than 90 days, as a backstop.
DRAFTS_BUCKET=
# A Bedrock Data Automation project with the transcript and text detection turned on for video (the
# built-in project has no transcript), and the account's profile for the region:
#   arn:aws:bedrock:us-east-1:<account id>:data-automation-profile/us.data-automation-v1
DATA_AUTOMATION_PROJECT_ARN=
DATA_AUTOMATION_PROFILE_ARN=
# The model that judges what is shown in a video, and the one that judges what was said and takes the
# second look at frames. JUDGE_MODEL is the brief's model unless set.
VIDEO_MODEL="us.amazon.nova-pro-v1:0"
# JUDGE_MODEL=
# Where in the bucket the sample clip for demo accounts is kept. Leave empty for no sample.
SAMPLE_VIDEO_KEY=

# Email, for the brand's two notices after a post is live. Leave RESEND_API_KEY empty to run without
# it: nothing is emailed, and the creator's post carries the brand's link to send instead.
# From resend.com > API Keys (a key allowed to send is enough). EMAIL_FROM must be on a domain verified
# at resend.com > Domains. Until one is, "onboarding@resend.dev" works as the sender but delivers only
# to the Resend account's own address.
RESEND_API_KEY=
# For example: EMAIL_FROM="Cleared <notices@your-domain.example>"
EMAIL_FROM=

# AWS credentials. Set none of these for the usual case: locally the service uses what `aws configure`
# saved, and on ECS it uses the task's role. To use something else locally, uncomment one choice.
# A named profile from ~/.aws:
# AWS_PROFILE=
# Or keys for an IAM user made for this service, allowed only what it uses. Never an account's root keys.
# What it needs:
#   - on the drafts bucket: s3:ListBucket, and on its objects s3:GetObject, s3:PutObject, s3:DeleteObject,
#     s3:AbortMultipartUpload, s3:ListMultipartUploadParts
#   - bedrock-mantle:CreateInference on the account's default project (Claude)
#   - bedrock:InvokeModel on the video model and its inference profile (Nova)
#   - bedrock:InvokeDataAutomationAsync and bedrock:GetDataAutomationStatus on the Data Automation project,
#     the profile, and the account's invocations
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# Or a Bedrock API key. If set, it is used instead of everything above:
# AWS_BEARER_TOKEN_BEDROCK=

# PayPal SANDBOX app credentials, from developer.paypal.com > Apps & Credentials > Sandbox.
# Set them in .env only. Never live credentials: the service talks to the sandbox and nothing else.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# The id PayPal gives a webhook once one is registered for the deployed address. Leave empty until then.
PAYPAL_WEBHOOK_ID=

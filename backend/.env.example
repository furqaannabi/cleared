# Copy to .env (gitignored). Bun loads .env on its own.
# Local values only: they match docker-compose.yml. Real secrets never go here.

# The local Postgres container started by `pnpm db:up`.
DATABASE_URL="postgresql://cleared:cleared@127.0.0.1:5432/cleared"

# Port the API listens on. The frontend's dev server uses 3000.
PORT=4000

# PayPal SANDBOX app credentials, from developer.paypal.com > Apps & Credentials > Sandbox.
# Set them in .env only. Never live credentials: the service talks to the sandbox and nothing else.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# The id PayPal gives a webhook once one is registered for the deployed address. Leave empty until then.
PAYPAL_WEBHOOK_ID=

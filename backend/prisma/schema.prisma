// Each model is added with the spec that needs it (CLAUDE.md: no code without a signed spec).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Timers and retries (money path spec MP-FR-42, MP-FR-43;
// docs/decisions/2026-10-08-jobs-table-in-postgres.md).
// A job is written in the same transaction as the change it belongs to.
model Job {
  id      String @id @default(uuid())
  /// Which handler runs it.
  name    String
  /// What the handler needs. Ids only: no emails, tokens or PayPal payloads.
  payload Json

  /// When it is due.
  runAt       DateTime
  status      JobStatus @default(pending)
  /// While running: when another worker may take it over, if this one died.
  lockedUntil DateTime?

  /// How many times it has been started, and how many of those ended in an error.
  attempts  Int     @default(0)
  failures  Int     @default(0)
  /// The last error's message, shortened. Never a payload.
  lastError String?

  createdAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([status, runAt])
}

enum JobStatus {
  pending
  running
  done
  /// Gave up after the retry limit. Stays in the table so a person can see it.
  failed
}

// One deliverable's money (money path spec, "Schema";
// docs/decisions/2026-10-08-money-state-as-one-document.md).
model DeliverableMoney {
  deliverableId String @id
  /// The whole state the transition rules produce. Read and written only by the money module.
  state         Json
  /// Copied out of the state so they can be searched.
  stage         String
  amountCents   Int
  /// Goes up by one with every change.
  version       Int    @default(0)
  /// The creator's PayPal email, read at the moment a payout is sent. Never inside the state.
  payoutEmail   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  calls  PayPalCall[]
  record MoneyRecord[]

  @@index([stage])
}

// One thing asked of PayPal (MP-BR-06, MP-BR-07). It is written as started before PayPal is
// called, and settled when PayPal has given a final answer. A started call is followed up.
model PayPalCall {
  id            String @id @default(uuid())
  deliverableId String
  /// What the call is for, and which attempt, capture, payout or confirmation it belongs to.
  purpose       String
  subjectId     String
  /// Sent to PayPal as its request id. The same call sent again uses the same id.
  requestId     String @unique @default(uuid())

  status    PayPalCallStatus @default(started)
  /// PayPal's id for what the call made: an order, a hold, a capture or a payout.
  reference String?
  startedAt DateTime
  settledAt DateTime?

  money DeliverableMoney @relation(fields: [deliverableId], references: [deliverableId])

  @@unique([deliverableId, purpose, subjectId])
  @@index([reference])
  @@index([status])
}

enum PayPalCallStatus {
  started
  settled
}

// The money record (MP-FR-41): every change, PayPal call and notice, with its cause.
// Entries are only ever added.
model MoneyRecord {
  id            Int    @id @default(autoincrement())
  deliverableId String
  at            DateTime
  /// event: a change to the money state. paypal_call: something asked of PayPal. notice: something to tell someone.
  kind          String
  /// The event's type, the call's purpose, or what the notice is about.
  name          String
  /// What caused it: a function call, a job, a webhook, or PayPal's answer to a call.
  cause         String
  /// The stage after it.
  stage         String
  /// A PayPal reference, when there is one.
  reference     String?
  /// Ids and outcomes only: no emails, tokens or PayPal payloads (MP-BR-11).
  details       Json?

  money DeliverableMoney @relation(fields: [deliverableId], references: [deliverableId])

  @@index([deliverableId, id])
}

// Events PayPal has delivered (MP-FR-36). Kept under PayPal's own event id so each is acted on once.
// The event's content is not kept: only what it was and what was done with it (MP-BR-11).
model PayPalEvent {
  /// PayPal's id for the event.
  id            String @id
  type          String
  status        PayPalEventStatus @default(received)
  /// What was done with it: handled, or ignored because it fitted no allowed change.
  outcome       String?
  deliverableId String?
  receivedAt    DateTime
}

enum PayPalEventStatus {
  /// Verified and stored, not yet acted on. Delivered again in this state, it is acted on.
  received
  done
}

// A creator: the person who starts deals and is paid (deal set-up spec DS-FR-02, DS-FR-06).
model Creator {
  id          String  @id @default(uuid())
  /// Google's id for the account they sign in with. Null for a demo creator.
  googleId    String? @unique
  name        String
  email       String?
  /// A per-visit demo account: made-up data, on the PayPal sandbox (DS-BR-17).
  demo        Boolean @default(false)
  /// A hash of the address a demo account was made from, to limit how many one address makes (DS-FR-07).
  madeFrom    String?
  welcomedAt  DateTime?
  /// Where payouts go. Shown to the creator only (DS-BR-13).
  paypalEmail String?
  createdAt   DateTime

  sessions Session[]
  accounts ConnectedAccount[]
  deals    Deal[]

  @@index([demo, madeFrom, createdAt])
}

// A signed-in browser (DS-BR-02). Only a hash of its token is kept. It is either a creator's, or a
// brand's: made from one invite link and good for that link's deal alone (DS-FR-34).
model Session {
  id         String   @id @default(uuid())
  tokenHash  String   @unique
  creatorId  String?
  /// The invite link a brand's session was made from. It ends with the link (DS-FR-33).
  linkId     String?
  createdAt  DateTime
  lastUsedAt DateTime
  expiresAt  DateTime

  creator Creator?    @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  link    InviteLink? @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@index([creatorId])
  @@index([linkId])
}

// A platform account a creator has connected (DS-FR-11). Read-only access, and its token is
// kept encrypted (DS-BR-14).
model ConnectedAccount {
  id                    String  @id @default(uuid())
  creatorId             String
  platform              String
  /// The platform's own id for the channel or account.
  externalId            String
  name                  String
  /// Made up, for a demo account. It has no token and reaches no platform.
  synthetic             Boolean @default(false)
  refreshTokenEncrypted String?
  connectedAt           DateTime

  creator Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@unique([creatorId, platform])
}

// One sponsorship between a creator and a brand (deal set-up spec DS-FR-13). Only its creator can
// read or change it (DS-BR-01).
model Deal {
  id        String @id @default(uuid())
  creatorId String
  /// The brand's name, as the creator typed it. Plain text.
  brandName String
  /// checklist, invite, waiting_for_brand, changes_requested or agreed.
  step      String @default("checklist")
  /// Where reading the brief stands: idle, reading, done or failed.
  reading   String @default("idle")
  /// The brief as numbered lines of plain text. Untrusted: shown as text, never acted on (DS-BR-04).
  briefLines Json?
  /// The brand's email, if the creator gave one. Nothing is sent to it (DS-FR-30).
  brandEmail String?
  /// The creator's timezone when the link was made, which a deadline's date is read in (DS-FR-31).
  timezone   String?
  /// True from the brand sending notes until the creator sends updated terms (DS-FR-38, DS-FR-40).
  /// The brand's link stays on meanwhile, whichever step the creator is editing at.
  revising   Boolean @default(false)
  /// When the brand agreed, and to which version of the terms (DS-FR-41, DS-FR-42).
  agreedAt      DateTime?
  agreedVersion Int?
  createdAt DateTime

  creator      Creator         @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  deliverables Deliverable[]
  items        ChecklistItem[]
  questions    Question[]
  links        InviteLink[]
  versions     TermsVersion[]
  notes        Note[]

  @@index([creatorId, createdAt])
}

// One post on one platform. Its id is the id its money goes by in the money path.
model Deliverable {
  id       String @id @default(uuid())
  dealId   String
  /// youtube_video or youtube_short.
  platform String
  /// Its place among the deal's posts, as the creator ordered them.
  position Int
  /// What the brand pays for this post, in whole cents (DS-FR-29, DS-BR-12).
  amountCents  Int?
  /// How many days after the hold the post is due, 1 to 21 (DS-FR-29).
  deadlineDays Int?

  deal  Deal            @relation(fields: [dealId], references: [id], onDelete: Cascade)
  items ChecklistItem[]

  @@index([dealId, position])
}

// One thing a post is checked against (DS-FR-19). It cites a line of the brief unless the creator
// added it (DS-BR-06).
model ChecklistItem {
  id             String  @id @default(uuid())
  dealId         String
  deliverableId  String
  name           String
  /// said, shown_as_text, shown, timing, written, disclosure or publication.
  kind           String
  /// The brief line it came from. Null only for an item the creator added.
  briefLine      Int?
  addedByCreator Boolean @default(false)
  /// A code, link or hashtag that must appear exactly.
  exact          String?
  /// How it will be checked. Decided by code, never by the model (DS-FR-20).
  checkedBy      String
  /// The question whose answer made this item, so re-answering it takes the item away (DS-FR-23).
  questionId     String?
  position       Int

  deal        Deal        @relation(fields: [dealId], references: [id], onDelete: Cascade)
  deliverable Deliverable @relation(fields: [deliverableId], references: [id], onDelete: Cascade)

  @@index([dealId, position])
}

// A line of the brief the model found ambiguous (DS-FR-21).
model Question {
  id          String  @id @default(uuid())
  dealId      String
  briefLine   Int
  text        String
  /// The suggested answers, each with the item it would make. The items stay on the backend.
  suggestions Json
  /// suggestion, own_words or left_out, once answered.
  answerKind  String?
  answerText  String?
  position    Int

  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId, position])
}

// The brand's way in to one deal (DS-FR-31). Only a hash of its token is kept, with the salt the token
// is worked out from again when its creator asks (DS-FR-32, DS-BR-11).
model InviteLink {
  id          String    @id @default(uuid())
  dealId      String
  tokenHash   String    @unique
  salt        String
  createdAt   DateTime
  expiresAt   DateTime
  /// Set when the creator replaces the link or changes the terms. A link turned off never works again.
  turnedOffAt DateTime?
  /// For a review link: the post it lands on (DR-FR-44). Null for the deal's invite link.
  deliverableId String?
  /// Set when the brand has nothing left to do on the draft the link was made for (DR-FR-45). The link
  /// then opens nothing new, but sessions already made from it last until it expires.
  closedAt    DateTime?

  deal     Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)
  sessions Session[]

  @@index([dealId, createdAt])
}

// The terms and the checklist exactly as they were sent to the brand (DS-FR-31). The brand agrees to
// one of these by its number (DS-BR-10).
model TermsVersion {
  id        String   @id @default(uuid())
  dealId    String
  number    Int
  /// Each post's amount and deadline, and every item, as they stood.
  terms     Json
  createdAt DateTime

  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@unique([dealId, number])
}

// Something the brand asked to be changed, and the creator's reply (DS-FR-38, DS-FR-39). Both are
// untrusted plain text: shown as text, never acted on (DS-BR-04).
model Note {
  id            String   @id @default(uuid())
  dealId        String
  /// What it is about: item, line, amount, deadline or deal.
  kind          String
  itemId        String?
  briefLine     Int?
  deliverableId String?
  text          String
  reply         String?
  /// The version the brand was shown when it wrote the note.
  version       Int
  position      Int
  createdAt     DateTime

  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId, position])
}

// One brief sent to be read, kept to enforce the limits on reading (DS-FR-26, DS-FR-27). It is not
// tied to the creator's row, so a deleted demo account still counts towards the day's total.
model BriefRead {
  id          String   @id @default(uuid())
  creatorId   String
  at          DateTime
  /// False until the model is about to be called. A read that never called it is removed (DS-BR-16).
  modelCalled Boolean  @default(false)

  @@index([creatorId, at])
  @@index([at])
}

// A video file a creator sent to be checked before publishing (draft check and review spec DR-FR-02).
// Private: reached only through a short-lived address (DR-BR-12). Its name is the creator's own text.
model Draft {
  id            String   @id @default(uuid())
  deliverableId String
  /// The file's name as the creator's browser gave it. Untrusted plain text, shown and never used as a path.
  fileName      String
  /// Where the file is in the bucket. Made by the service, never from the file's name.
  storageKey    String
  sizeBytes     BigInt
  durationSec   Float
  createdAt     DateTime

  @@index([deliverableId, createdAt])
}

// Where one post's draft check and review stand (DR-FR-25). One row per post, made when its first
// draft is sent. The rules that change it are a pure function (src/review/rules.ts).
model DraftCheck {
  deliverableId  String    @id
  /// How many runs have finished. A check that fails is not a run (DR-BR-16).
  run            Int       @default(0)
  /// no_draft, checking, check_failed or done.
  phase          String    @default("no_draft")
  /// The latest draft accepted for checking.
  draftId        String?
  checkStartedAt DateTime?
  windowOpenedAt DateTime?
  windowEndsAt   DateTime?
  objectedAt     DateTime?
  /// brand or window, once the draft is approved.
  approvedBy     String?
  approvedAt     DateTime?
  /// Whether the brand is shown this run's draft: from the first ask or the window's start (DR-FR-48).
  shown          Boolean   @default(false)
  /// When a brand session first read this run's review (DR-FR-46).
  reviewOpenedAt DateTime?
  /// The last file that could not be checked because of the file itself, until a draft is accepted (DR-FR-03).
  fileFailure    Json?
  /// Where a running check has got to: reading, said, shown or confirming (DR-FR-10).
  stage          String?
  /// How many times the running check has failed on Cleared's side. It is tried again a few times (DR-FR-23).
  failures       Int       @default(0)
  /// The reading of the video that Data Automation is doing, or has done, for the running check.
  speechJobId    String?
}

// One checklist item's result in a post's latest finished run, with the creator's ask about it and the
// brand's answer (DR-FR-21, DR-FR-30 to DR-FR-33). Evidence belongs to its run and is replaced with it.
model CheckItem {
  deliverableId String
  /// The checklist item's id, as in the version of the terms the brand agreed to.
  itemId        String
  position      Int
  /// passed, fix_needed, unsure or at_live_check.
  result        String
  /// exact_match, ai_timestamp, from_timestamps, published_post or platform_record.
  checkedBy     String
  /// A label, the words or description, and the start and end in seconds. Untrusted text from the video or a model.
  evidence      Json?
  /// One plain sentence saying what to change. Never shown to the brand (DR-BR-13).
  hint          String?
  /// none, waiting, accepted or declined.
  ask           String  @default("none")
  /// When the creator asked the brand about it, while the ask stands.
  askedAt       DateTime?
  objected      Boolean @default(false)
  /// The brand's note: with a request to fix it, or with its objection. Untrusted plain text (DR-BR-09).
  brandNote     String?
  /// How it read to its creator in the run before, and at the moment a newer draft replaced it.
  previous      String?
  whenReplaced  String?

  @@id([deliverableId, itemId])
  @@index([deliverableId, position])
}

// Video sent for analysis, kept to enforce the limits on drafts (DR-FR-06 to DR-FR-08). It is not
// tied to the creator's row, so a deleted demo account still counts towards the day's total.
model DraftUsage {
  id            String   @id @default(uuid())
  creatorId     String
  deliverableId String
  draftId       String   @unique
  seconds       Float
  at            DateTime
  /// False until analysis starts. A draft that fails before then is removed and counts for nothing (DR-BR-16).
  analysed      Boolean  @default(false)

  @@index([creatorId, at])
  @@index([at])
}


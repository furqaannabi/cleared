{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:generate": "bun --env-file=.env --bun prisma generate",
    "db:migrate": "bun --env-file=.env --bun prisma migrate dev"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "prisma": "7.10.0",
    "typescript": "^5"
  }
}

{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:sandbox": "bun test ./sandbox/paypal.sandbox.ts",
    "test:bedrock": "bun test ./sandbox/bedrock.sandbox.ts",
    "contract": "bun src/contract/contract.ts",
    "sandbox:hold": "bun sandbox/make-hold.ts",
    "sandbox:money": "bun sandbox/money.ts",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:generate": "bun --env-file=.env --bun prisma generate",
    "db:migrate": "bun --env-file=.env --bun prisma migrate dev"
  },
  "dependencies": {
    "@anthropic-ai/bedrock-sdk": "^0.34.4",
    "@anthropic-ai/sdk": "^0.132.1",
    "@hono/zod-openapi": "^1.6.3",
    "@paypal/paypal-server-sdk": "2.5.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "hono": "^4.13.13",
    "jose": "^6.2.12",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "openapi-typescript": "7.13.0",
    "prisma": "7.10.0",
    "typescript": "^5"
  }
}
